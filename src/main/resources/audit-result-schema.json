{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["isPass", "action", "reason"],
  "properties": {
    "isPass": {
      "type": "boolean",
      "description": "是否通过审核"
    },
    "violationType": {
      "type": ["string", "null"],
      "enum": ["色情低俗", "暴力恐怖", "政治敏感", "人身攻击/辱骂", "违法违禁", "垃圾广告", "引战歧视", "泄露隐私", null],
      "description": "违规类型，合规时为null"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "审核理由"
    },
    "action": {
      "type": "string",
      "enum": ["pass", "block", "review"],
      "description": "审核动作"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "isPass": { "const": true } }
      },
      "then": {
        "properties": {
          "action": { "const": "pass" },
          "violationType": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": { "isPass": { "const": false } }
      },
      "then": {
        "properties": {
          "action": { "enum": ["block", "review"] }
        }
      }
    }
  ]
}